{
  "name": "belfry-desktop-plugins-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "python3 ../scripts/prepare_website.py && next dev",
    "build": "python3 ../scripts/prepare_website.py && next build",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "format:check": "prettier --check app components lib next.config.mjs",
    "format": "prettier --write app components lib next.config.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
